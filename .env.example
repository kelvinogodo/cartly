# Copy to .env.local and fill in real values (never commit .env.local).

# Browser (inlined by Vite; safe to expose — access is enforced by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local scripts only (npm run db:migrate / db:seed) — never prefix these with VITE_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CARTLY_DB_PASSWORD=
# Optional: session-pooler host, needed on IPv4-only networks because the direct
# DB host (db.<ref>.supabase.co) is IPv6-only. Supabase dashboard -> Connect -> Session pooler.
# CARTLY_DB_HOST=aws-1-<region>.pooler.supabase.com
